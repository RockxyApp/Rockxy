    "Rules decide which HTTPS hosts Rockxy decrypts. Other hosts still pass through Rockxy as opaque TLS tunnels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则决定 Rockxy 解密哪些 HTTPS 主机。其他主机仍会作为不透明的 TLS 隧道通过 Rockxy。"
          }
        }
      }
    },
    "Rules Hit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命中规则"
          }
        }
      }
