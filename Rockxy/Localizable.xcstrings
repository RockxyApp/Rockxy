            "state": "translated",
            "value": "查看 Rockxy 的最新发布详情。"
          }
        }
      }
    },
    "Review the matched rule before sharing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享前请审查匹配的规则。"
          }
        }
      }
    },
    "Review this capture before it loads into the current session.": {
      "localizations": {
        "zh-Hans": {
