            "state": "translated",
            "value": "Map Remote 编辑器"
          }
        }
      }
    },
    "MAP REMOTE OFF": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MAP REMOTE 已关闭"
          }
        }
      }
    },
    "Map Remote participates in Rockxy's global first-match rule order. Blank fields keep matched request components; changing Protocol with a blank Port uses the new protocol's default.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map Remote 遵循 Rockxy 的全局首个匹配规则顺序。留空的字段会保留匹配请求的组件；更改协议但端口留空时，将使用新协议的默认端口。"
          }
        }
      }
    },
    "Map Remote redirects a matching request to a different host, port, or path — handy for pointing an app at staging or a local server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map Remote 会将匹配的请求重定向到其他主机、端口或路径，适合将 App 指向预发布环境或本地服务器。"
          }
        }
      }
    },
    "Map Remote supports HTTP and HTTPS destinations.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map Remote 支持 HTTP 和 HTTPS 目标。"
          }
        }
      }
    },
