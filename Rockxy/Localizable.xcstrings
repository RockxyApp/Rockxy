    "Run Locally": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地运行"
          }
        }
      }
    },
    "Run one known HTTPS flow from the app or system UI and confirm Rockxy captures it before debugging deeper flows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 App 或系统 UI 发起一次已知的 HTTPS 流程，并确认 Rockxy 能捕获它，再调试更深层的流程。"
          }
        }
      }
    },
    "Run one throwaway container to confirm host.docker.internal + the mounted CA work end-to-end.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行一个一次性容器，确认 host.docker.internal 和挂载的 CA 可端到端正常工作。"
          }
        }
      }
    },
    "Run one throwaway curlimages/curl container with HTTP_PROXY pointed at host.docker.internal and the PEM mounted in, then let Rockxy catch the probe.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行一个一次性的 curlimages/curl 容器，将 HTTP_PROXY 指向 host.docker.internal 并挂载 PEM，然后让 Rockxy 捕获探测请求。"
          }
        }
      }
    },
    "Run Probe Again": {
      "localizations": {
        "zh-Hans": {
