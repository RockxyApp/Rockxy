    "Welcome to Rockxy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 Rockxy"
          }
        }
      }
    },
    "What authentication evidence should I verify next?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来我应该验证哪些身份验证证据？"
          }
        }
      }
    },
    "What should I add before sharing this bug report?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在共享此错误报告之前，我应该添加什么？"
          }
        }
      }
    },
    "What should I inspect next in Rockxy?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来我应该在 Rockxy 中检查什么？"
          }
        }
      }
    },
    "When enabled, Rockxy downloads signed updates ahead of time so install prompts are faster.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Rockxy 会提前下载已签名的更新，从而更快显示安装提示。"
          }
        }
      }
    },
    "When matched": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配时"
          }
        }
      }
    },
    "When off, Block List rules are skipped. Other intervention rules remain active.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后将跳过阻止列表规则。其他干预规则仍保持生效。"
          }
        }
      }
    },
    "When off, Modify Header rules are skipped during evaluation. Other rule types are unaffected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，求值时会跳过修改标头规则。其他规则类型不受影响。"
          }
        }
      }
    },
    "When off, Rockxy captures all traffic. Individual Allow List rules keep their enabled state.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，Rockxy 会捕获所有流量。各允许列表规则会保留其启用状态。"
          }
        }
      }
    },
    "When off, Rockxy sends store=false with every Responses API request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，Rockxy 会随每个 Responses API 请求发送 store=false。"
          }
        }
      }
    },
    "When off, Rockxy tunnels all HTTPS without decrypting it. Individual rules keep their state.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，Rockxy 会通过隧道传输所有 HTTPS 而不进行解密。各条规则会保留其状态。"
          }
        }
      }
    },
    "Where": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
