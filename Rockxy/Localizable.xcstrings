        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时运行"
          }
        }
      }
    },
    "Send another private loopback request through the running listener.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次通过运行中的监听器发送私有环回请求。"
