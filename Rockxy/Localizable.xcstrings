    "The administrator authorization prompt was cancelled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员授权提示已取消。"
          }
        }
      }
    },
    "The Allow List restricts capture to the hosts you specify, so Rockxy ignores everything else and the request list stays focused.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表将捕获限制为你指定的主机，因此 Rockxy 会忽略其他主机，使请求列表保持聚焦。"
          }
        }
      }
    },
    "The app and helper have mismatched signing certificates.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和辅助工具的签名证书不匹配。"
          }
        }
      }
    },
    "The app rejected Rockxy’s TLS handshake for this host. Certificate pinning is possible, but a custom trust policy can produce the same signal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用拒绝了 Rockxy 针对此主机的 TLS 握手。应用可能启用了证书固定，但自定义信任策略也可能产生相同信号。"
          }
        }
      }
    },
    "The authenticated identity may not have permission.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过身份验证的身份可能没有权限。"
          }
        }
      }
    },
    "The Babylon listener isn't running. Clients can't connect until it restarts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Babylon 监听器未运行。在它重新启动前，客户端无法连接。"
          }
        }
      }
    },
    "The Babylon listener isn't running. Open Pairing to review and retry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Babylon 监听器未运行。请打开“配对”进行检查并重试。"
          }
        }
      }
    },
    "The Babylon listener stopped unexpectedly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Babylon 监听器意外停止。"
          }
        }
      }
    },
    "The Block List returns 403 or drops the connection for matching requests, so you can simulate an endpoint being unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止列表会对匹配请求返回 403 或断开连接，让你可以模拟端点不可用的情况。"
          }
        }
      }
    },
    "The body is protected. Request-line, status, and header changes can still be applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正文受保护。仍可应用请求行、状态和标头更改。"
          }
        }
      }
    },
    "The Breakpoint Queue lets you inspect, edit, continue, or abort traffic after this rule pauses it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断点队列让你可以在此规则暂停流量后检查、编辑、继续或中止流量。"
          }
        }
      }
    },
    "The captured requests are no longer available for review.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获的请求已不再可供审查。"
          }
        }
      }
    },
    "The captured response exceeded the configured buffer limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获的响应超过了配置的缓冲区限制。"
          }
        }
      }
    },
    "The captured response was HTTP %lld, so Rockxy shows a completed request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获的响应为 HTTP %lld，因此 Rockxy 显示已完成的请求。"
          }
        }
      }
    },
    "The captured response was HTTP %lld.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获的响应为 HTTP %lld。"
          }
        }
      }
    },
    "The certificate and private key do not belong to the same identity.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书和私钥不属于同一身份。"
          }
        }
      }
    },
    "The certificate could not be converted for preview.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法转换证书以供预览。"
          }
        }
      }
    },
    "The certificate is in the keychain but trust settings are missing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书已在钥匙串中，但缺少信任设置。"
          }
        }
      }
    },
    "The certificate was not changed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书未更改。"
          }
        }
      }
    },
    "The configured model ‘%@’ was not found.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到配置的模型 ‘%@’。"
          }
        }
      }
    },
    "The configured provider endpoint is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置的提供商端点无效。"
          }
        }
      }
    },
    "The configured provider is processing the reviewed request context.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配置的提供商正在处理已审查的请求上下文。"
          }
        }
      }
    },
    "The CONNECT exchange establishes a tunnel; application HTTPS payloads belong to traffic inside that tunnel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CONNECT 交互会建立隧道；应用程序 HTTPS 有效载荷属于该隧道内的流量。"
          }
        }
      }
    },
    "The credential value remains hidden.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据值仍处于隐藏状态。"
          }
        }
      }
    },
    "The cURL command does not contain a URL.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 cURL 命令不包含 URL。"
          }
        }
      }
    },
    "The current captured response is unchanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前捕获的响应未更改"
          }
        }
      }
    },
    "The current session is empty. Importing loads %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话为空。导入将加载 %@。"
          }
        }
      }
    },
    "The current session is empty. Opening loads %@ and %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The current session is empty. Opening loads %1$@ and %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话为空。打开后将加载 %1$@ 和 %2$@。"
          }
        }
      }
    },
    "The destination protocol, host, and port still choose the remote server. Path and query overrides are ignored while this is enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标协议、主机和端口仍用于选择远程服务器。启用此选项时，路径和查询覆盖项将被忽略。"
          }
        }
      }
    },
    "The developer signature and Gatekeeper approval are checked before installation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装前会检查开发者签名和 Gatekeeper 批准状态。"
          }
        }
      }
    },
    "The downloaded application does not match the expected runtime identity.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的应用程序与预期的运行时身份不匹配。"
          }
        }
      }
    },
    "The downloaded application was not signed by the expected developer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的应用程序未由预期的开发者签名。"
          }
        }
      }
    },
    "The downloaded runtime archive failed Rockxy's structure and size checks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的运行时归档未通过 Rockxy 的结构和大小检查。"
          }
        }
      }
    },
    "The fetch snippet confirms that a predictable React Native request can reach Rockxy after the platform proxy and trust path is ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fetch 代码片段可确认，在平台代理和信任路径准备就绪后，可预测的 React Native 请求能够到达 Rockxy。"
          }
        }
      }
    },
    "The file is not a valid Allow List settings export.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是有效的允许列表设置导出文件。"
          }
        }
      }
    },
    "The file is not a valid Block List settings export.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是有效的阻止列表设置导出文件。"
          }
        }
      }
    },
    "The file is not a valid Charles Proxy SSL settings export.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是有效的 Charles Proxy SSL 设置导出文件。"
          }
        }
      }
    },
    "The file is not a valid HTTPToolkit settings export.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是有效的 HTTPToolkit 设置导出。"
          }
        }
      }
    },
    "The file is not a valid SSL settings export.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是有效的 SSL 设置导出文件。"
          }
        }
      }
    },
    "The first enabled rule that matches pauses the request, response, or both. Disabling a rule affects future matches; traffic already waiting remains in the Breakpoint Queue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一条匹配的已启用规则会暂停请求、响应或两者。禁用规则会影响未来的匹配；已经等待的流量仍会留在断点队列中。"
          }
        }
      }
    },
    "The Gist payload is %@, which is larger than the 25 MB limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gist 有效载荷为 %@，超过了 25 MB 的限制。"
          }
        }
      }
    },
    "The GitHub authorization code expired.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 授权码已过期。"
          }
        }
      }
    },
    "The helper is registered, but Rockxy cannot reach it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助工具已注册，但 Rockxy 无法与其连接。"
          }
        }
      }
    },
    "the helper tool could not be used": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用辅助工具"
          }
        }
      }
    },
    "the helper tool has a signing issue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助工具存在签名问题"
          }
        }
      }
    },
    "the helper tool is not installed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助工具未安装"
          }
        }
      }
    },
    "the helper tool is unreachable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问辅助工具"
          }
        }
      }
    },
    "the helper tool needs to be updated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新辅助工具"
          }
        }
      }
    },
    "the helper tool still needs approval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助工具仍需批准"
          }
        }
      }
    },
    "the helper tool version is incompatible": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助工具版本不兼容"
          }
        }
      }
    },
    "The helper tool will be removed. Rockxy will use networksetup and may ask for your password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助工具将被移除。Rockxy 将使用 networksetup，并可能要求你输入密码。"
          }
        }
      }
    },
    "The Host header is preserved from the original request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原始请求中的 Host 标头。"
          }
        }
      }
    },
    "The Host header stays as the original request sent it. The destination host, DNS lookup, and TLS server name still use the rewritten host above.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Host 标头会保持原始请求发送时的值。目标主机、DNS 查询和 TLS 服务器名称仍使用上方重写后的主机。"
          }
        }
      }
    },
    "The HTTPS authority is fixed for this connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接的 HTTPS 授权机构是固定的"
          }
        }
      }
    },
    "The import contains invalid or duplicate Full Proxy Bypass entries.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入内容包含无效或重复的完全代理绕过条目。"
          }
        }
      }
    },
    "The import file must be 1 MB or smaller.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入文件不得大于 1 MB。"
          }
        }
      }
    },
    "the installed helper does not match this copy of Rockxy — reinstall it before continuing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的辅助工具与此 Rockxy 副本不匹配，请重新安装后再继续"
          }
        }
      }
    },
    "The installed helper does not match this copy of Rockxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的辅助工具与此 Rockxy 副本不匹配。"
          }
        }
      }
    },
    "The installed helper is incompatible with this version of Rockxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装的辅助工具与此版本的 Rockxy 不兼容。"
          }
        }
      }
    },
    "The iOS Simulator shares the Mac's network stack, so Rockxy's loopback listen address is typically reachable without LAN configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 模拟器与 Mac 共享网络栈，因此通常无需配置局域网即可访问 Rockxy 的回环监听地址。"
          }
        }
      }
    },
    "The link only serves the public PEM, expires automatically, and stops when this sheet closes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该链接仅提供公开的 PEM，会自动过期，并在此面板关闭时停止。"
          }
        }
      }
    },
    "The listener is accepting local-network connections on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听器正在这台 Mac 上接受本地网络连接。"
          }
        }
      }
    },
    "The listener is waiting for a viable network. Runtime events will resume automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听器正在等待可用网络。运行时事件将自动恢复。"
          }
        }
      }
    },
    "The listener stays available, but new traffic is not being added.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听器仍然可用，但不会添加新流量。"
          }
        }
      }
    },
    "The listener will resume automatically when a viable network becomes available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当可用网络恢复时，监听器将自动继续运行。"
          }
        }
      }
    },
    "The local model is reading the reviewed request context.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型正在读取已审查的请求上下文。"
          }
        }
      }
    },
    "The local schema storage could not be read. Retry before changing local schema files.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取本地架构存储。更改本地架构文件前请重试。"
          }
        }
      }
    },
    "The matching pattern is not a valid regular expression.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配模式不是有效的正则表达式。"
          }
        }
      }
    },
    "The model completed without returning text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型已完成处理，但未返回文本。"
          }
        }
      }
    },
    "The original captured traffic is no longer available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始捕获流量已不可用。"
          }
        }
      }
    },
    "The private key for this certificate could not be found in Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在钥匙串中找不到此证书的私钥。"
          }
        }
      }
    },
    "The Project catalog revision limit was reached.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到项目目录修订版本上限。"
          }
        }
      }
    },
    "The Project configuration could not be processed safely. Verify the file and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全处理项目配置。请验证文件后重试。"
          }
        }
      }
    },
    "The Project could not be updated. Try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新项目。请重试。"
          }
        }
      }
    },
    "The Project name is not in canonical Unicode form.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目名称不是规范的 Unicode 形式。"
          }
        }
      }
    },
    "The provider configuration changed. Review the outbound data again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商配置已更改。请再次审查传出数据。"
          }
        }
      }
    },
    "The provider could not be reached: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问提供商：%@"
          }
        }
      }
    },
    "The provider credential cannot access this model or endpoint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该提供商凭据无法访问此模型或端点。"
          }
        }
      }
    },
    "The provider credential is missing. Replace it in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少提供商凭据。请在设置中替换它。"
          }
        }
      }
    },
    "The provider rate limit was reached. Try again in %lld seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到提供商速率限制。请在 %lld 秒后重试。"
          }
        }
      }
    },
    "The provider rate limit was reached. Try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到提供商速率限制。请稍后重试。"
          }
        }
      }
    },
    "The provider rejected the request: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商拒绝了请求：%@"
          }
        }
      }
    },
    "The provider rejected the saved credential.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商拒绝了已保存的凭据。"
          }
        }
      }
    },
    "The provider request timed out.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商请求超时。"
          }
        }
      }
    },
    "The provider request was cancelled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商请求已取消。"
          }
        }
      }
    },
    "The provider returned an invalid response: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商返回了无效响应：%@"
          }
        }
      }
    },
    "The provider returned HTTP %lld: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The provider returned HTTP %1$lld: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商返回了 HTTP %1$lld：%2$@"
          }
        }
      }
    },
    "The proxy helper tool will be removed. You may be prompted for your password when changing proxy settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理辅助工具将被移除。更改代理设置时，系统可能会提示你输入密码。"
          }
        }
      }
    },
    "The proxy is stopped. Start it to begin capturing requests.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理已停止。请启动它以开始捕获请求。"
          }
        }
      }
    },
    "The proxy server is running, but proxy-aware traffic is not automatically routed through Rockxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理服务器正在运行，但支持代理的流量不会自动通过 Rockxy 路由。"
          }
        }
      }
    },
    "The reconciled Projects were structurally invalid and were not applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并整理后的项目结构无效，未被应用。"
          }
        }
      }
    },
    "The request was not authenticated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未通过认证。"
          }
        }
      }
    },
    "The response body exceeded the %@ MB Compose limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应正文超过了 %@ MB 的 Compose 限制。"
          }
        }
      }
    },
    "The response body is empty.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应正文为空。"
          }
        }
      }
    },
    "The response explicitly supplied a retry delay.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应明确提供了重试延迟。"
          }
        }
      }
    },
    "The reviewed context exceeds Rockxy's outbound size limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审查的上下文超过了 Rockxy 的出站大小限制。"
          }
        }
      }
    },
    "The Rockxy Community source edition is licensed under AGPL-3.0-or-later.\n": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy Community 源码版采用 AGPL-3.0-or-later 许可证。\n"
          }
        }
      }
    },
    "The Rockxy root certificate is trusted for HTTPS interception.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 根证书受信任，可用于 HTTPS 拦截。"
          }
        }
      }
    },
    "The root CA exists locally. Install and trust it in Keychain to decrypt HTTPS traffic.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根 CA 已存在于本地。请在钥匙串中安装并信任它，以解密 HTTPS 流量。"
          }
        }
      }
    },
    "The Root CA fingerprint changed before sharing. Stop sharing and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享前根 CA 指纹发生了变化。请停止共享并重试。"
          }
        }
      }
    },
    "The Root CA fingerprint is unavailable. Stop sharing and regenerate the Root CA before installing it on another device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根 CA 指纹不可用。请先停止共享并重新生成根 CA，然后再将其安装到其他设备上。"
          }
        }
      }
    },
    "The root CA is installed, but macOS has not fully trusted it for TLS yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根 CA 已安装，但 macOS 尚未完全信任它用于 TLS。"
          }
        }
      }
    },
    "The runtime download ended before the artifact was complete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行时下载在工件完成前结束。"
          }
        }
      }
    },
    "The runtime download exceeded Rockxy's safety limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行时下载超出了 Rockxy 的安全限制。"
          }
        }
      }
    },
    "The runtime download server rejected the request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行时下载服务器拒绝了该请求。"
          }
        }
      }
    },
    "The saved GitHub token does not have permission to create Gists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 GitHub 令牌没有创建 Gist 的权限。"
          }
        }
      }
    },
    "The saved Upstream Proxy configuration changed while you were editing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的上游代理配置在你编辑期间发生了更改。"
          }
        }
      }
    },
    "The schema was not deleted, but its mapping references could not be restored: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "架构未被删除，但无法恢复其映射引用：%@"
          }
        }
      }
    },
    "The script bundle could not be found after reloading.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载后找不到脚本包。"
          }
        }
      }
    },
    "The selected .proto file is empty.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 .proto 文件为空。"
          }
        }
      }
    },
    "The selected .proto file is not valid UTF-8 text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 .proto 文件不是有效的 UTF-8 文本。"
          }
        }
      }
    },
    "The selected certificate must be a valid PEM or DER X.509 certificate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选证书必须是有效的 PEM 或 DER X.509 证书。"
          }
        }
      }
    },
    "The selected file is not valid UTF-8 text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件不是有效的 UTF-8 文本。"
          }
        }
      }
    },
    "The selected full HTTP response file controls this status code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选完整 HTTP 响应文件控制此状态码。"
          }
        }
      }
    },
    "The selected model does not support this request: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选模型不支持此请求：%@"
          }
        }
      }
    },
    "The selected P12 file could not be imported. Check that the file contains a certificate and private key, then try the correct password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入所选 P12 文件。请检查文件是否包含证书和私钥，然后使用正确的密码重试。"
          }
        }
      }
    },
    "The selected P12 file does not contain a certificate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 P12 文件不包含证书。"
          }
        }
      }
    },
    "The selected private key must be a valid PEM or DER private key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定的私钥必须是有效的 PEM 或 DER 私钥。"
          }
        }
      }
    },
    "The selected Project no longer exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目已不存在。"
          }
        }
      }
    },
    "The selected request differs from a captured successful baseline.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选请求与捕获的成功基线不同。"
          }
        }
      }
    },
    "The selected request failed before a completed response was captured.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选请求在捕获到完整响应前失败。"
          }
        }
      }
    },
    "The selected request was rejected by an authentication or authorization check.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选请求被身份验证或授权检查拒绝。"
          }
        }
      }
    },
    "The selected volume needs at least %@ free; %@ is available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The selected volume needs at least %1$@ free; %2$@ is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选宗卷至少需要 %1$@ 可用空间；当前有 %2$@ 可用。"
          }
        }
      }
    },
    "The server denied access; captured traffic cannot verify the required permission policy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝访问；捕获的流量无法验证所需的权限策略。"
          }
        }
      }
    },
    "The server requested authentication and no common credential header was captured.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器要求身份验证，但未捕获到常见的凭据标头。"
          }
        }
      }
    },
    "The simulator can usually reach Rockxy through the Mac network path. Trust the Root CA inside the simulator, then rebuild or cold-launch the app after trust changes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器通常可以通过 Mac 网络路径连接 Rockxy。请在模拟器中信任根 CA，然后在更改信任设置后重新构建或冷启动 App。"
          }
        }
      }
    },
    "The simulator shares the Mac's network stack, so loopback is reachable; export or share the Rockxy PEM, install it in the simulator, and enable full trust for it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器共享 Mac 的网络栈，因此可访问环回地址；请导出或共享 Rockxy PEM，将其安装到模拟器，并为其启用完全信任。"
          }
        }
      }
    },
    "The stored schema list could not be read. Retry before changing local files.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取存储的架构列表。更改本地文件前请重试。"
          }
        }
      }
    },
    "The stored schema list could not be read. Retry before changing local schema files.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取存储的架构列表。更改本地架构文件前请重试。"
          }
        }
      }
    },
    "The token is missing the required gist scope.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌缺少所需的 gist 权限范围。"
          }
        }
      }
    },
    "The traffic scope changed. Review the exact data again before model access.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流量范围已更改。在模型访问之前，请再次查看具体数据。"
          }
        }
      }
    },
    "The Traffic Tab name is not in canonical Unicode form.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“流量标签页”名称不是规范的 Unicode 形式。"
          }
        }
      }
    },
    "The update has been downloaded and verified. Install now to relaunch into the latest version.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已下载并验证。立即安装以重新启动进入最新版本。"
          }
        }
      }
    },
    "The update was installed, but Rockxy did not relaunch automatically. Quit and reopen Rockxy to finish using the updated version.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已安装，但 Rockxy 未自动重新启动。请退出并重新打开 Rockxy，以完成更新版本的启用。"
          }
        }
      }
    },
    "The user asked a Rockxy product question.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户询问了一个 Rockxy 产品问题。"
          }
        }
      }
    },
    "The verified app remains installed. Rockxy can open it and check the service again without downloading it twice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证的 App 仍处于安装状态。Rockxy 可以打开它并再次检查服务，无需重复下载。"
          }
        }
      }
    },
    "The Xcode simulators for watchOS and tvOS share the Mac's networking, so Rockxy's loopback is usually reachable without LAN setup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "watchOS 和 tvOS 的 Xcode 模拟器共享 Mac 的网络，因此通常无需 LAN 设置即可访问 Rockxy 的回环地址。"
          }
        }
      }
    },
    "There are %lld requests currently retained in this session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话中保留了 %lld 个请求。"
          }
        }
      }
    },
    "There is 1 request currently retained in this session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话当前保留了 1 个请求。"
          }
        }
      }
    },
    "There is no dedicated device-pairing workflow today; treat this page as honest guidance rather than a one-click setup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有专用的设备配对工作流程；请将此页面视为如实指引，而非一键设置。"
          }
        }
      }
    },
    "These badges reflect Rockxy's current adapter path. Vision, reasoning, and model-level tool support are not inferred from the provider name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些徽章反映 Rockxy 当前的适配器路径。不会根据提供商名称推断视觉、推理和模型级工具支持。"
          }
        }
      }
    },
    "These hosts always stay encrypted when they pass through Rockxy. They do not bypass the proxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些主机通过 Rockxy 时始终保持加密。它们不会绕过代理。"
          }
        }
      }
    },
    "These mapping definitions are stored locally on this Mac. This build decodes Protobuf with heuristics only — saved mappings and schemas are not applied to captured traffic.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些映射定义存储在这台 Mac 本地。此版本仅使用启发式方法解码 Protobuf — 已保存的映射和架构不会应用于已捕获的流量。"
          }
        }
      }
    },
    "These platforms reuse the iOS device and simulator setup: a reachable listen address plus the Rockxy root certificate trusted inside the runtime.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些平台复用 iOS 设备和模拟器的设置：一个可访问的监听地址，加上在运行时中受信任的 Rockxy 根证书。"
          }
        }
      }
    },
    "Third-Party Software Notices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方软件声明"
          }
        }
      }
    },
    "This %@ request targets %@. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This %1$@ request targets %2$@. %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 %1$@ 请求的目标是 %2$@。%3$@"
          }
        }
      }
    },
    "This app is signed by “%@” but the installed helper expects “%@”. Reinstall the helper from the current build, or run the matching release version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This app is signed by “%1$@” but the installed helper expects “%2$@”. Reinstall the helper from the current build, or run the matching release version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用由“%1$@”签名，但已安装的辅助工具预期“%2$@”。请从当前构建重新安装辅助工具，或运行匹配的发布版本。"
          }
        }
      }
    },
    "This body is not UTF-8 text, so body edits are disabled. Applying request-line, status, or header changes preserves every body byte.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此正文不是 UTF-8 文本，因此正文编辑已停用。应用请求行、状态或标头更改时，会保留正文的每个字节。"
          }
        }
      }
    },
    "This build does not allow upstream proxy credentials. Existing saved credentials remain in secure storage until authentication is removed and applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不允许上游代理凭据。现有的已保存凭据将保留在安全存储中，直到移除并应用身份验证设置为止。"
          }
        }
      }
    },
    "This build keeps SOCKS5 visible for configuration compatibility, but it cannot be selected or applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本为了配置兼容性而保留 SOCKS5 可见，但它无法被选择或应用。"
          }
        }
      }
    },
    "This build stores up to %lld local schemas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建版本最多存储 %lld 个本地架构。"
          }
        }
      }
    },
    "This build stores up to %lld local schemas. Remove one before importing another.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建最多可存储 %lld 个本地架构。请先移除一个，再导入其他架构。"
          }
        }
      }
    },
    "This build supports up to %lld Projects.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建版本最多支持 %lld 个项目。"
          }
        }
      }
    },
    "This captured request has a binary body that the text editor cannot replay safely. Replace it in the Body tab or use an empty body.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此捕获请求的正文为二进制数据，文本编辑器无法安全重放。请在“正文”标签页中替换它，或使用空正文。"
          }
        }
      }
    },
    "This certificate expires in %lld days. Replace it soon to avoid interrupting HTTPS interception.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此证书将在 %lld 天后过期。请尽快替换，以免 HTTPS 拦截中断。"
          }
        }
      }
    },
    "This certificate has expired. Generate and trust a new certificate to restore HTTPS interception.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此证书已过期。请生成并信任新证书以恢复 HTTPS 拦截。"
          }
        }
      }
    },
    "This CONNECT request asked the proxy to open a tunnel to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 CONNECT 请求要求代理打开通往 %@ 的隧道。"
          }
        }
      }
    },
    "This CONNECT request established a proxy tunnel to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 CONNECT 请求建立了通往 %@ 的代理隧道。"
          }
        }
      }
    },
    "This conversation belongs to different traffic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话属于其他流量"
          }
        }
      }
    },
    "This deletes %@ from Ollama. Rockxy cannot undo this action.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从 Ollama 删除 %@。Rockxy 无法撤销此操作。"
          }
        }
      }
    },
    "This export includes private key material. Store it securely and only share it with people or systems you trust.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此导出包含私钥材料。请安全存储，且仅与受信任的人员或系统共享。"
          }
        }
      }
    },
    "This file starts like an HTTP response but is malformed. Rockxy will continue to the origin until the file is corrected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件看起来像 HTTP 响应，但格式无效。在修复文件之前，Rockxy 将继续请求源服务器。"
          }
        }
      }
    },
    "This Focus Set is active. Click to reapply it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此焦点集已启用。点击可重新应用。"
          }
        }
      }
    },
    "This frame does not look like a valid Protobuf wire-format payload.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此帧看起来不是有效的 Protobuf 线格式有效载荷。"
          }
        }
      }
    },
    "This gRPC message is compressed. Rockxy preserves the frame boundary but does not decode compressed message payloads yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 gRPC 消息已压缩。Rockxy 会保留帧边界，但尚未解码压缩的消息有效载荷。"
          }
        }
      }
    },
    "This header column is already added and shown.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标头列已添加并显示。"
          }
        }
      }
    },
    "This host also has the opposite behavior. Tunnel Without Decryption takes priority; row order does not affect matching.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机还具有相反的行为。“不解密隧道”优先；行顺序不影响匹配。"
          }
        }
      }
    },
    "This host has both behaviors. Tunnel Without Decryption takes priority.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机同时具有两种行为。“不解密隧道”优先。"
          }
        }
      }
    },
    "This host pattern is already in Full Proxy Bypass.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机模式已在完全绕过代理列表中。"
          }
        }
      }
    },
    "This import replaces the current host rules. Application rules, the master state, and TLS passthrough exceptions remain unchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次导入将替换当前主机规则。应用规则、主开关状态和 TLS 直通例外保持不变。"
          }
        }
      }
    },
    "This link serves only your public Rockxy Root CA from this Mac. It expires automatically. Do not install certificates from unknown sources.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此链接仅从这台 Mac 提供你的公开 Rockxy 根 CA。它会自动过期。请勿安装来源不明的证书。"
          }
        }
      }
    },
    "This Mac and local network": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 和本地网络"
          }
        }
      }
    },
    "This Mac only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限这台 Mac"
          }
        }
      }
    },
    "This mapping definition was deleted in another window.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此映射定义已在另一个窗口中删除。"
          }
        }
      }
    },
    "This profile is eligible for intercepted HTTP and HTTPS traffic that reaches it in Rockxy's global first-match rule order.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置适用于按 Rockxy 全局首个匹配规则顺序到达它的已拦截 HTTP 和 HTTPS 流量。"
          }
        }
      }
    },
    "This provider needs its native adapter. Select OpenAI, Anthropic, Gemini, an OpenAI-compatible endpoint, or Ollama.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供商需要使用其原生适配器。请选择 OpenAI、Anthropic、Gemini、OpenAI 兼容端点或 Ollama。"
          }
        }
      }
    },
    "This removes all locally stored Compose request and response history.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除所有本地存储的 Compose 请求和响应历史记录。"
          }
        }
      }
    },
    "This removes every captured runtime event from memory. HTTP traffic and Babylon pairing are not affected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从内存中移除每个已捕获的运行时事件。HTTP 流量和 Babylon 配对不受影响。"
          }
        }
      }
    },
    "This removes every stored shared value for “%@”. This cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将移除为“%@”存储的所有共享值。此操作无法撤销。"
          }
        }
      }
    },
    "This removes Rockxy's generated root CA, trust settings, cached host certificates, and custom certificate records.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除 Rockxy 生成的根 CA、信任设置、缓存的主机证书和自定义证书记录。"
          }
        }
      }
    },
    "This removes the conversation from this workspace history.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从此工作区历史记录中移除该对话。"
          }
        }
      }
    },
    "This removes the Project, its in-memory traffic history, and its saved Traffic Tab configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将移除该项目、其内存中的流量历史记录以及其保存的 Traffic Tab 配置。"
          }
        }
      }
    },
    "This removes the stored %@ file from this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从这台 Mac 移除存储的 %@ 文件。"
          }
        }
      }
    },
    "This request body was shortened for local history storage. Replace it in the Body tab before sending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了存入本地历史记录，此请求正文已被缩短。发送前，请在“正文”标签页中将其替换。"
          }
        }
      }
    },
    "This request does not contain WebSocket frames.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求不包含 WebSocket 帧。"
          }
        }
      }
    },
    "This request has no body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求没有正文"
          }
        }
      }
    },
    "This request has no body.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求没有正文。"
          }
        }
      }
    },
    "This request has no host.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求没有主机。"
          }
        }
      }
    },
    "This response does not look like captured AI model traffic.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此响应看起来不像捕获的 AI 模型流量。"
          }
        }
      }
    },
    "This response has no body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此响应没有正文"
          }
        }
      }
    },
    "This response has no body.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此响应没有正文。"
          }
        }
      }
    },
    "This response stays encrypted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此响应保持加密状态。"
          }
        }
      }
    },
    "This review is limited to the selected requests. Other traffic will not be included.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此审查仅限于所选请求。其他流量将不会被包含。"
          }
        }
      }
    },
    "This Rockxy app package is incomplete, so the helper tool cannot be installed. Reinstall the latest Rockxy release. If you installed Rockxy from Homebrew, reinstall it after the fixed release is published.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Rockxy App 包不完整，因此无法安装辅助工具。请重新安装最新的 Rockxy 版本。如果你通过 Homebrew 安装了 Rockxy，请在修复版本发布后重新安装。"
          }
        }
      }
    },
    "This row exists for honest guidance; do not expect one-click pairing or automated certificate installation for the headset today.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此行旨在提供如实指引；目前不要期待头显会支持一键配对或自动安装证书。"
          }
        }
      }
    },
    "This rule could not be saved. Disable another Breakpoint rule and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存此规则。请停用另一条断点规则后重试。"
          }
        }
      }
    },
    "This rule could not be saved. Disable another Network Conditions rule and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存此规则。请停用另一条网络条件规则，然后重试。"
          }
        }
      }
    },
    "This runs sfltool resetbtm after removing Rockxy helper files. It can reset Background Items state for other apps, so use it only when the normal force reset cannot recover Rockxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会在移除 Rockxy 辅助工具文件后运行 sfltool resetbtm。它可能会重置其他 App 的后台项状态，因此仅应在正常强制重置无法恢复 Rockxy 时使用。"
          }
        }
      }
    },
    "This saved definition is not applied to captured traffic in this build.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此构建中，这个已保存的定义不会应用于捕获的流量。"
          }
        }
      }
    },
    "this script": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此脚本"
          }
        }
      }
    },
    "This shares basic macOS and hardware compatibility details with Sparkle so Rockxy can match the right update. It does not include captured traffic.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会与 Sparkle 共享基本的 macOS 和硬件兼容性详细信息，以便 Rockxy 匹配正确的更新。其中不包含捕获的流量。"
          }
        }
      }
    },
    "This source is already muted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此来源已静音。"
          }
        }
      }
    },
    "This target currently ships as guidance only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此目标目前仅提供指导。"
          }
        }
      }
    },
    "This version of Rockxy does not allow new local schema imports. Existing files can still be removed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Rockxy 不允许导入新的本地架构。现有文件仍可移除。"
          }
        }
      }
    },
    "This view uses heuristic Protobuf decoding. Saved schemas and mapping definitions are stored locally and are not applied to gRPC traffic in this build.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视图使用启发式 Protobuf 解码。已保存的架构和映射定义存储在本地，且在此版本中不会应用于 gRPC 流量。"
          }
        }
      }
    },
    "This will delete the root CA and all generated host certificates. You will need to generate and install a new root CA to resume HTTPS interception.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除根 CA 和所有生成的主机证书。你需要生成并安装新的根 CA 才能恢复 HTTPS 拦截。"
          }
        }
      }
    },
    "This will delete the root CA and all generated host certificates. You will need to generate and install a new root CA.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除根 CA 以及所有已生成的主机证书。你需要生成并安装新的根 CA。"
          }
        }
      }
    },
    "This will install the root certificate in your macOS Keychain and mark it as trusted. macOS will prompt you for your password to authorize this change.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将根证书安装到你的 macOS 钥匙串并标记为受信任。macOS 会提示你输入密码以授权此更改。"
          }
        }
      }
    },
    "Throttle API": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制 API 速率"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间"
          }
        }
      }
    },
    "Time to First Byte": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首字节时间"
          }
        }
      }
    },
    "Time to first byte accounts for most of the request duration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首字节时间占请求时长的大部分。"
          }
        }
      }
    },
    "Timed out": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已超时"
          }
        }
      }
    },
    "Timing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时序"
          }
        }
      }
    },
    "Timing and Stream": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时序与流"
          }
        }
      }
    },
    "TLS": {
      "shouldTranslate": false
    },
    "TLS Handshake": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 握手"
          }
        }
      }
    },
    "TLS only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅 TLS"
          }
        }
      }
    },
    "TLS Passthrough Exceptions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 直通例外"
          }
        }
      }
    },
    "TLS Passthrough Exceptions…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 直通例外…"
          }
        }
      }
    },
    "TLS Validation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 验证"
          }
        }
      }
    },
    "To read or write Gists on a user's behalf, Rockxy requires Gist Permission from your GitHub account. After the authorization, your GitHub Access Token will securely store in System Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要代表用户读取或写入 Gist，Rockxy 需要你 GitHub 账户的 Gist 权限。授权后，你的 GitHub 访问令牌将安全地存储在系统钥匙串中。"
          }
        }
      }
    },
    "Toggle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换"
          }
        }
      }
    },
    "Toggle all scripts in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 %@ 中的所有脚本"
          }
        }
      }
    },
    "Toggle Console": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换控制台"
          }
        }
      }
    },
    "Toggle Enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换启用"
          }
        }
      }
    },
    "Toggle readiness inspector": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换就绪状态检查器"
          }
        }
      }
    },
    "Toggle Recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换记录"
          }
        }
      }
    },
    "Toggle Shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换显示状态"
          }
        }
      }
    },
    "Toggle Source List Panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换来源列表面板"
          }
        }
      }
    },
    "Toggle System Proxy": {
      "localizations": {
        "zh-Hans": {
