    "Wildcard patterns support * for any sequence and ? for one character. Turn on Include subpaths to extend the match beyond this URL.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通配符模式支持用 * 匹配任意字符序列，用 ? 匹配单个字符。开启“包含子路径”可将匹配范围扩展到此 URL 之外。"
          }
        }
      }
    },
