    },
    "Right": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧"
          }
        }
      }
    },
    "Right text": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧文本"
          }
        }
      }
    },
    "Rockxy %@ is now available. You’re currently using %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Rockxy %1$@ is now available. You’re currently using %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy %1$@ 现已可用。你当前使用的是 %2$@。"
          }
        }
      }
    },
    "Rockxy %@ is ready to install.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy %@ 已准备好安装。"
          }
        }
      }
    },
    "Rockxy binds IPv4 only. IPv6 dual-stack listening isn't available yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 仅绑定 IPv4。目前尚不支持 IPv6 双栈监听。"
          }
        }
      }
    },
    "Rockxy blocked %lld model action request(s).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 阻止了 %lld 个模型操作请求。"
          }
        }
      }
    },
    "Rockxy can identify this AI app session, but model, tokens, and tools need decrypted API evidence.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 可以识别此 AI App 会话，但模型、token 和工具需要解密后的 API 证据。"
          }
        }
      }
    },
    "Rockxy can share this Mac's public Root CA over a temporary local link, while Android still requires manual proxy, user CA, and debug trust configuration; release builds generally will not trust user CAs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 可通过临时本地链接共享这台 Mac 的公开根 CA，而 Android 仍需手动配置代理、用户 CA 和调试信任；发布构建通常不会信任用户 CA。"
          }
        }
      }
    },
    "Rockxy can share this Mac's public Root CA over a temporary local link, while iOS still requires you to install and trust it manually on the device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 可以通过临时本地链接共享这台 Mac 的公开根 CA，但 iOS 仍要求你在设备上手动安装并信任它。"
          }
        }
      }
    },
    "Rockxy cannot access this custom root certificate and its private key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法访问此自定义根证书及其私钥。"
          }
        }
      }
    },
    "Rockxy cannot confirm the request outcome from this transaction.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法从此事务确认请求结果。"
          }
        }
      }
    },
    "Rockxy could not identify every rejecting client. ": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法识别所有拒绝证书的客户端。"
          }
        }
      }
    },
    "Rockxy cannot inspect response headers or payload for this request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法检查此请求的响应标头或有效载荷。"
          }
        }
      }
    },
    "Rockxy cannot read the certificate and trust status right now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 目前无法读取证书和信任状态。"
          }
        }
      }
    },
    "Rockxy cannot read the certificate and trust status right now. Nothing was changed — check the status again once your keychain is available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 目前无法读取证书和信任状态。未做任何更改——待钥匙串可用后请重新检查状态。"
          }
        }
      }
    },
    "Rockxy cannot verify the Root CA trust status, so HTTPS interception is paused. HTTP traffic and logs are still captured.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法验证根 CA 的信任状态，因此 HTTPS 拦截已暂停。HTTP 流量和日志仍会被捕获。"
          }
        }
      }
    },
    "Rockxy cannot write to %@. Choose another install folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法写入 %@。请选择其他安装文件夹。"
          }
        }
      }
    },
    "Rockxy captured the gRPC frame, but heuristic Protobuf decoding could not infer a safe tree.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已捕获该 gRPC 帧，但启发式 Protobuf 解码无法推断出安全的树结构。"
          }
        }
      }
    },
    "Rockxy captured the local validation probe and can reveal it in the main window.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已捕获本地验证探测，并可在主窗口中显示它。"
          }
        }
      }
    },
    "Rockxy Certificate is ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 证书已就绪。"
          }
        }
      }
    },
    "Rockxy could not communicate with the helper over XPC.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法通过 XPC 与辅助工具通信。"
          }
        }
      }
    },
    "Rockxy could not compute the Root CA fingerprint. Stop sharing and regenerate the Root CA before installing it on another device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法计算根 CA 指纹。在另一台设备上安装前，请停止共享并重新生成根 CA。"
          }
        }
      }
    },
    "Rockxy could not find the root CA private key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 找不到根 CA 私钥。"
          }
        }
      }
    },
    "Rockxy could not fully recover the custom certificate store. Restart Rockxy before making more certificate changes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法完全恢复自定义证书存储。进一步更改证书前，请重新启动 Rockxy。"
          }
        }
      }
    },
    "Rockxy could not include the excluded traffic. The reviewed data is unchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法包含已排除的流量。审查的数据未发生变化。"
          }
        }
      }
    },
    "Rockxy could not load the default root certificate details.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法加载默认根证书的详细信息。"
          }
        }
      }
    },
    "Rockxy could not read the Keychain or trust state. Nothing was changed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法读取钥匙串或信任状态。未做任何更改。"
          }
        }
      }
    },
    "Rockxy could not read the certificate status, so nothing was changed. Recheck the status once your keychain is available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法读取证书状态，因此未做任何更改。待钥匙串可用后请重新检查状态。"
          }
        }
      }
    },
    "Rockxy could not prepare the Full Proxy Bypass export.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法准备完全代理绕过导出内容。"
          }
        }
      }
    },
    "Rockxy could not prepare the HTTPS Decryption export.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法准备 HTTPS 解密导出。"
          }
        }
      }
    },
    "Rockxy could not render the reviewed context as UTF-8.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法将审查的上下文渲染为 UTF-8。"
          }
        }
      }
    },
    "Rockxy could not start the local validation probe. Reopen Developer Setup, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法启动本地验证探针。请重新打开开发者设置，然后重试。"
          }
        }
      }
    },
    "Rockxy could not start the temporary certificate sharing server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法启动临时的证书共享服务器。"
          }
        }
      }
    },
    "Rockxy could not verify this app copy — install a fresh copy before using the helper tool": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法验证此应用副本 — 请在使用辅助工具之前安装一个全新副本"
          }
        }
      }
    },
    "Rockxy could not verify this app copy. Install a fresh copy of Rockxy, then check the helper again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法验证此 App 副本。请安装全新的 Rockxy 副本，然后再次检查辅助工具。"
          }
        }
      }
    },
    "Rockxy could not verify this app copy. Open diagnostics before continuing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法验证此应用副本。请先打开诊断再继续。"
          }
        }
      }
    },
    "Rockxy decrypts HTTPS for hosts matching this pattern.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 会解密与此模式匹配的主机的 HTTPS 流量。"
          }
        }
      }
    },
    "Rockxy Default Root Certificate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 默认根证书"
          }
        }
      }
    },
    "Rockxy did not capture a completed response for this request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 未捕获到此请求的完整响应。"
          }
        }
      }
    },
    "Rockxy does not automate system-level certificate installation; if you need it, use a writable emulator image and the standard adb remount flow yourself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 不会自动安装系统级证书；如有需要，请使用可写的模拟器映像，并自行执行标准 adb remount 流程。"
          }
        }
      }
    },
    "Rockxy does not automate tvOS or watchOS pairing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 不会自动完成 tvOS 或 watchOS 配对"
          }
        }
      }
    },
    "Rockxy does not automate tvOS or watchOS pairing today; use this page for the same prerequisites that apply to iOS devices and simulators.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 目前不会自动完成 tvOS 或 watchOS 配对；请使用此页面了解与 iOS 设备和模拟器相同的前提条件。"
          }
        }
      }
    },
    "Rockxy does not collect analytics or crash reports. Captured traffic stays on your machine unless you explicitly export, share, or publish it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 不收集分析或崩溃报告。捕获的流量会留在你这台 Mac 上，除非你明确导出、共享或发布。"
          }
        }
      }
    },
    "Rockxy does not drive simctl or inject the certificate into a simulator; reinstall or cold-launch the target app after the certificate is trusted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 不会驱动 simctl，也不会将证书注入模拟器；信任证书后，请重新安装或冷启动目标 App。"
          }
        }
      }
    },
    "Rockxy does not ship a dedicated Vision Pro pairing flow; follow the iOS Device page for the same manual steps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 未提供专门的 Vision Pro 配对流程；请按照 iOS 设备页面执行相同的手动步骤。"
          }
        }
      }
    },
    "Rockxy downloads this PAC file when resolving a new route.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 在解析新路由时会下载此 PAC 文件。"
          }
        }
      }
    },
    "Rockxy found no captured 401 or 403 response for this request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 未找到此请求的已捕获 401 或 403 响应。"
          }
        }
      }
    },
    "Rockxy found no captured HTTP failure status for the selected request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 未发现所选请求有已捕获的 HTTP 失败状态。"
          }
        }
      }
    },
    "Rockxy generates a local root Certificate Authority (CA) to create per-host certificates for HTTPS traffic interception. The root CA must be installed and trusted in your macOS Keychain. No certificate data leaves your machine.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 会生成本地根证书颁发机构 (CA)，以便为每个主机创建证书并拦截 HTTPS 流量。必须在 macOS 钥匙串中安装并信任根 CA。任何证书数据都不会离开这台 Mac。"
          }
        }
      }
    },
    "Rockxy generates a scoped setup script before launching.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 会在启动前生成限定范围的设置脚本。"
          }
        }
      }
    },
    "Rockxy has not generated a root certificate yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 尚未生成根证书。"
          }
        }
      }
    },
    "Rockxy import replaces the current rules, master state, and TLS passthrough exceptions. Export first if you need a backup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 导入会替换当前规则、主开关状态和 TLS 直通例外。如需备份，请先导出。"
          }
        }
      }
    },
    "Rockxy iOS": {
      "shouldTranslate": false
    },
    "Rockxy is already preparing %@. Wait for that launch to finish, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已在准备 %@。请等待该启动流程完成后再试。"
          }
        }
      }
    },
    "Rockxy is capturing traffic on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在这台 Mac 上捕获流量。"
          }
        }
      }
    },
    "Rockxy is capturing. Send a request through the proxy and it will appear here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在捕获。通过代理发送请求后，它会显示在这里。"
          }
        }
      }
    },
    "Rockxy is comparing your current build against the signed update feed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在将当前构建与已签名的更新源进行比较。"
          }
        }
      }
    },
    "Rockxy is downloading the signed update and verifying it before installation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在下载已签名的更新，并在安装前进行验证。"
          }
        }
      }
    },
    "Rockxy is extracting the update and preparing the app bundle for installation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在解压更新并准备用于安装的应用程序包。"
          }
        }
      }
    },
    "Rockxy is finishing the installation and will relaunch automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在完成安装，并将自动重新启动。"
          }
        }
      }
    },
    "Rockxy is listening on %@:%lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Rockxy is listening on %1$@:%2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在监听 %1$@:%2$lld。"
          }
        }
      }
    },
    "Rockxy is listening on this address now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 现在正在此地址上监听。"
          }
        }
      }
    },
    "Rockxy is starting the proxy. Captured requests will appear here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在启动代理。捕获的请求将显示在此处。"
          }
        }
      }
    },
    "Rockxy is up to date": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已是最新版本"
          }
        }
      }
    },
    "Rockxy is up to date.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已是最新版本。"
          }
        }
      }
    },
    "Rockxy is using direct macOS proxy changes because %@. If Rockxy or Xcode stops unexpectedly, your Mac may stay behind a dead proxy until Rockxy restores it. Install or repair the helper tool for safer automatic cleanup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 %@，Rockxy 正在直接更改 macOS 代理。如果 Rockxy 或 Xcode 意外停止，你的 Mac 可能会一直使用失效的代理，直到 Rockxy 将其恢复。请安装或修复辅助工具，以便更安全地自动清理。"
          }
        }
      }
    },
    "Rockxy is using its default root certificate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在使用其默认根证书。"
          }
        }
      }
    },
    "Rockxy is verifying this custom root certificate and its private key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在验证此自定义根证书及其私钥。"
          }
        }
      }
    },
    "Rockxy is waiting for the app to terminate so installation can finish safely.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在等待 App 终止，以便安全完成安装。"
          }
        }
      }
    },
    "Rockxy kept the app connected by returning this host to a protected encrypted tunnel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 通过将此主机重新置于受保护的加密隧道，使应用保持连接。"
          }
        }
      }
    },
    "Rockxy kept the existing catalog unchanged and disabled Project edits to avoid overwriting data.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 保持现有目录不变，并停用了项目编辑，以避免覆盖数据。"
          }
        }
      }
    },
    "Rockxy must keep at least one Project.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 必须至少保留一个项目。"
          }
        }
      }
    },
    "Rockxy needs a Root CA certificate to inspect HTTPS traffic. This wizard will generate a local certificate, install it in your macOS Keychain, and verify the setup. No certificate data leaves your machine.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 需要根 CA 证书才能检查 HTTPS 流量。此向导将生成本地证书，将其安装到你的 macOS 钥匙串，并验证设置。任何证书数据都不会离开这台 Mac。"
          }
        }
      }
    },
    "Rockxy needs to be reopened before it can use the helper tool": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 需要重新打开才能使用辅助工具"
          }
        }
      }
    },
    "Rockxy only installs local runtimes from an encrypted HTTPS source.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 仅从加密的 HTTPS 源安装本地运行时。"
          }
        }
      }
    },
    "Rockxy prepared a bounded evidence package for this captured failure.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已为此次捕获的失败准备了受限证据包。"
          }
        }
      }
    },
    "Rockxy prepares a scoped shell for %@ pointed at the local proxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 会为 %@ 准备一个指向本地代理的限定范围 Shell。"
          }
        }
      }
    },
    "Rockxy provides the Dev Hub guide and temporary certificate share link; app-level TLS still depends on a debug network-security-config.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供 Dev Hub 指南和临时证书共享链接；App 级 TLS 仍依赖调试 network-security-config。"
          }
        }
      }
    },
    "Rockxy received status %lld and has no recent TLS rejection for this host.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 收到状态 %lld，并且此主机最近没有 TLS 拒绝记录。"
          }
        }
      }
    },
    "Rockxy reinstalled the helper but still cannot reach it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已重新安装辅助工具，但仍无法访问它。"
          }
        }
      }
    },
    "Rockxy removed stale helper files and asked macOS to reset Login and Background Items data.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已移除过时的辅助工具文件，并请求 macOS 重置登录项和后台项数据。"
          }
        }
      }
    },
    "Rockxy removed stale helper files and launchd registration state.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已移除过时的辅助工具文件和 launchd 注册状态。"
          }
        }
      }
    },
    "Rockxy safety range: 1–32,768. The selected model may allow less.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 安全范围：1–32,768。选定的模型可能允许更小的值。"
          }
        }
      }
    },
    "Rockxy saved the certificate export successfully.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 已成功保存证书导出。"
          }
        }
      }
    },
    "Rockxy Session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 会话"
          }
        }
      }
    },
    "Rockxy ships a dynamic route handler plus the next dev env block, including NODE_USE_ENV_PROXY, so server-side fetch can then route through Rockxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供动态路由处理程序以及 next dev 环境配置块，其中包含 NODE_USE_ENV_PROXY，以便服务器端 fetch 随后可通过 Rockxy 路由。"
          }
        }
      }
    },
    "Rockxy ships a Firefox settings snippet plus a cURL preflight step so you can confirm the proxy path before touching the browser.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供 Firefox 设置片段和 cURL 预检步骤，以便你在更改浏览器前确认代理路径。"
          }
        }
      }
    },
    "Automatic Setup prepares a scoped shell that sets JAVA_TOOL_OPTIONS proxy properties for the JVM. For a GUI development tool, quit it and use Choose & Open Developer App so Rockxy can apply the scoped environment and prepare recognized app-level proxy settings. For HTTPS interception, import the Rockxy root CA into the exact JVM or IDE trust store with keytool, add a Decrypt rule for the target application or host, then run the HttpClient sample to confirm capture.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动设置会准备一个作用域 shell，为 JVM 设置 JAVA_TOOL_OPTIONS 代理属性。对于 GUI 开发工具，请先退出，再使用“选择并打开开发者应用”，让 Rockxy 应用作用域环境并准备已识别的应用级代理设置。要拦截 HTTPS，请使用 keytool 将 Rockxy 根 CA 导入对应的 JVM 或 IDE 信任库，为目标应用或主机添加解密规则，然后运行 HttpClient 示例确认流量已被捕获。"
          }
        }
      }
    },
    "Rockxy ships a manual reqwest snippet for HTTPS interception.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供用于 HTTPS 拦截的手动 reqwest 代码片段。"
          }
        }
      }
    },
    "Rockxy ships a Paw settings block plus a cURL preflight step so you can confirm the proxy path before sending from Paw.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供 Paw 设置块和一个 cURL 预检步骤，以便你在从 Paw 发送前确认代理路径。"
          }
        }
      }
    },
    "Rockxy ships a Postman settings block plus a cURL preflight so you can confirm the proxy path before touching the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供 Postman 设置块和 cURL 预检，让你无需改动 App 即可先确认代理路径。"
          }
        }
      }
    },
    "Rockxy ships a React Native fetch validation probe, Android network-security-config guidance, and Metro troubleshooting; proxy and certificate trust still belong to the underlying platform.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供 React Native fetch 验证探针、Android network-security-config 指南和 Metro 故障排除；代理和证书信任仍由底层平台负责。"
          }
        }
      }
    },
    "Rockxy ships a single docker run command that mounts the Rockxy PEM and probes capture through the local validation path.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供一条 docker run 命令，用于挂载 Rockxy PEM 并通过本地验证路径探测捕获。"
          }
        }
      }
    },
    "Rockxy ships an Insomnia settings block plus a cURL preflight step so you can confirm the proxy path before sending from the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供 Insomnia 设置块和 cURL 预检步骤，让你在从 App 发送请求前确认代理路径。"
          }
        }
      }
    },
    "Rockxy ships manual cURL examples for direct proxy flags and session environment variables.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供手动 cURL 示例，用于直接代理标志和会话环境变量。"
          }
        }
      }
    },
    "Rockxy ships manual Flutter snippets and a local capture check. The check confirms the probe reached Rockxy, not which device, emulator, simulator, or Dart runtime emitted it. Android Emulator no-code routing through a local VPN companion is not part of this manual flow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供手动 Flutter 代码片段和本地捕获检查。该检查确认探针已到达 Rockxy，但不确认是哪个设备、仿真器、模拟器或 Dart 运行时发出的。通过本地 VPN 伴侣应用对 Android Emulator 进行无代码路由不属于此手动流程。"
          }
        }
      }
    },
    "Rockxy ships manual setup snippets for requests, httpx, aiohttp, and urllib3.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 为 requests、httpx、aiohttp 和 urllib3 提供了手动设置代码片段。"
          }
        }
      }
    },
    "Rockxy ships manual snippets for axios, Node core, and got.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供适用于 axios、Node core 和 got 的手动配置片段。"
          }
        }
      }
    },
    "Rockxy ships manual snippets for net/http and Resty.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供适用于 net/http 和 Resty 的手动代码片段。"
          }
        }
      }
    },
    "Rockxy ships manual snippets for net/http, http, and Faraday.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供 net/http、http 和 Faraday 的手动代码片段。"
          }
        }
      }
    },
    "Rockxy ships one shell-launch command and one main-process session.setProxy snippet, both pointed at 127.0.0.1 on the active port.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 提供一个 shell 启动命令和一个主进程 session.setProxy 片段，两者都指向当前端口上的 127.0.0.1。"
          }
        }
      }
    },
    "Rockxy signs generated host certificates with its default root.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 使用其默认根证书为生成的主机证书签名。"
          }
        }
      }
    },
    "Rockxy signs generated host certificates with this imported root.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 使用此导入的根证书为生成的主机证书签名。"
          }
        }
      }
    },
    "Rockxy still cannot reach the installed helper.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 仍无法访问已安装的辅助工具。"
          }
        }
      }
    },
    "Rockxy stops after the first matching script returns a result.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首个匹配的脚本返回结果后，Rockxy 就会停止。"
          }
        }
      }
    },
    "Rockxy tunnels matching HTTPS without decrypting, overriding any Decrypt rule.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 会通过隧道传输匹配的 HTTPS 而不解密，并覆盖任何解密规则。"
          }
        }
      }
    },
    "Rockxy uses 8,192 tokens by default and limits local inference to 32,768 tokens to avoid excessive memory pressure.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 默认使用 8,192 个 token，并将本地推理限制为 32,768 个 token，以避免过大的内存压力。"
          }
        }
      }
    },
    "Rockxy v%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy v%@"
          }
        }
      }
    },
    "Rockxy was updated or replaced while it was open. Quit and reopen Rockxy, then check the helper again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 在打开状态下被更新或替换。请退出并重新打开 Rockxy，然后再次检查辅助工具。"
          }
        }
      }
    },
    "Rockxy will bind this address when the proxy starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理启动时，Rockxy 将绑定此地址。"
          }
        }
      }
    },
    "Rockxy will create an editable draft. Nothing is sent until you press Send in Compose.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 将创建可编辑的草稿。只有在 Compose 中按下“发送”后才会发送内容。"
          }
        }
      }
    },
    "Rockxy will create this response file when the rule is saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存规则时，Rockxy 将创建此响应文件。"
          }
        }
      }
    },
    "Rockxy will install Ollama.app inside the selected folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 会将 Ollama.app 安装到所选文件夹中。"
          }
        }
      }
    },
    "Rockxy will relaunch after installation completes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装完成后，Rockxy 将重新启动。"
          }
        }
      }
    },
    "Rockxy will remove the custom %@ certificate “%@”%@ and delete its private key from the Keychain. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Rockxy will remove the custom %1$@ certificate “%2$@”%3$@ and delete its private key from the Keychain. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 将移除自定义 %1$@ 证书“%2$@”%3$@，并从钥匙串中删除其私钥。此操作无法撤销。"
          }
        }
      }
    },
    "Rockxy will remove the custom root certificate “%@” and resume signing intercepted TLS connections with its generated root. Existing custom server and client certificates are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 将移除自定义根证书“%@”，并恢复使用其生成的根证书为拦截的 TLS 连接签名。现有自定义服务器和客户端证书会保留。"
          }
        }
      }
    },
    "Rockxy will remove these exclusions from the system proxy configuration for new connections.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 将从新连接的系统代理配置中移除这些排除项。"
          }
        }
      }
    },
    "Rockxy will replace the current catalog with one default Project. A bounded regular catalog is preserved as catalog.recovery.json. Captured traffic, sessions, rules, and favorites are not deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 会将当前目录替换为一个默认项目。有界的常规目录会保留为 catalog.recovery.json。捕获的流量、会话、规则和个人收藏不会被删除。"
          }
        }
      }
    },
    "Rockxy will request GitHub Gist permission using OAuth device authorization.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 将使用 OAuth 设备授权请求 GitHub Gist 权限。"
          }
        }
      }
    },
    "Rockxy will stop capture, request administrator approval, remove stale helper files and registration state, then reinstall the helper from this app.\n\nUse this when Install, Retry, Update, or Reinstall cannot recover the helper.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 将停止捕获、请求管理员批准、移除过时的辅助工具文件和注册状态，然后从此应用重新安装辅助工具。\n\n当“安装”、“重试”、“更新”或“重新安装”都无法恢复辅助工具时，请使用此功能。"
          }
        }
      }
    },
    "Rockxy will stop capture, request administrator approval, remove stale launchd and privileged helper files, then reinstall the helper from the current app bundle. System proxy settings may be restored during the reset.\n\nUse this only when install, uninstall, and recheck are stuck.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 将停止捕获、请求管理员批准、移除过时的 launchd 和特权辅助工具文件，然后从当前应用包重新安装辅助工具。重置期间系统代理设置可能会被恢复。\n\n仅在安装、卸载和重新检查均卡住时才使用此功能。"
          }
        }
      }
    },
    "Rockxy will use networksetup and may ask for your password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 将使用 networksetup，并可能要求你输入密码。"
          }
        }
      }
    },
    "Rockxy withholds body-level conclusions because capture truncated the response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于捕获截断了响应，Rockxy 不会对正文作出结论。"
          }
        }
      }
    },
    "Rockxy-owned response file available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有由 Rockxy 生成的响应文件可用"
          }
        }
      }
    },
