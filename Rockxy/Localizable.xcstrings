    "Set a manual HTTP proxy on the active Wi-Fi": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前 Wi-Fi 上设置手动 HTTP 代理"
          }
