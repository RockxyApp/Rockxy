    "Checking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "HTTPS traffic is staying as CONNECT tunnels because no Decrypt rule is enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未启用任何“解密”规则，因此 HTTPS 流量将以 CONNECT 隧道形式保留。"
          }
        }
      }
    },
    "Local path verified": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地链路已验证"
          }
        }
      }
    },
    "Not checked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检查"
          }
        }
      }
    },
    "Open Allow List and enable or create a valid rule.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开允许列表并启用或创建有效规则。"
          }
        }
      }
    },
    "Restore System Routing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复系统代理路由"
          }
        }
      }
    },
    "Rockxy could not verify its local capture path. The listener is running, but capture is not confirmed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法验证本地捕获链路。监听器正在运行，但尚未确认能够捕获。"
          }
        }
      }
    },
    "Rockxy could not restore the previous system proxy settings. Capture remains running so network traffic stays reachable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 无法恢复之前的系统代理设置。捕获将继续运行，以保持网络流量可达。"
          }
        }
      }
    },
    "Rockxy is sending a private loopback request through the listener to verify the capture path.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 正在通过监听器发送私有环回请求，以验证捕获链路。"
          }
        }
      }
    },
    "Rockxy's listener is running, but macOS browser traffic is routed elsewhere. Manually configured apps can still use the listener.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rockxy 的监听器正在运行，但 macOS 浏览器流量被路由到了其他位置。手动配置的应用仍可使用该监听器。"
          }
        }
      }
    },
    "Root CA trust is ready for HTTPS decryption.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Root CA 信任已就绪，可用于 HTTPS 解密。"
          }
        }
      }
    },
    "Route macOS HTTP and HTTPS traffic through the running Rockxy listener.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 macOS HTTP 和 HTTPS 流量路由到正在运行的 Rockxy 监听器。"
          }
        }
      }
    },
