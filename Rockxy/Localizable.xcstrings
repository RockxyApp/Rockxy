            "state": "translated",
            "value": "在将此捕获加载到当前会话前进行审查。"
          }
        }
      }
    },
    "Review what leaves this Mac before uploading to GitHub.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传到 GitHub 前，审查将离开这台 Mac 的内容。"
          }
        }
      }
    },
    "Reviewed Content Size": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已审查内容大小"
          }
        }
      }
    },
    "Rewrite matching requests to a different host, port, path, or query.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将匹配的请求重写到其他主机、端口、路径或查询。"
          }
        }
      }
    },
    "Rewrite requests and responses with JavaScript before they continue.": {
      "localizations": {
