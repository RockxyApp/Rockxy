    "Use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用"
          }
        }
      }
    },
    "Use * alone, or *.domain.com for subdomains.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独使用 *，或使用 *.domain.com 匹配子域名。"
          }
        }
      }
    },
    "Use 127.0.0.1 for iOS Simulator or desktop Flutter, 10.0.2.2 for Android Emulator, and the Device Proxy LAN host for physical devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 模拟器或桌面版 Flutter 请使用 127.0.0.1，Android 模拟器请使用 10.0.2.2，实体设备请使用“设备代理”的局域网主机。"
          }
        }
      }
    },
    "Use a proxy-aware Flutter client such as HttpClient, package:http, or Dio, then keep the iOS or Android device/emulator trust and proxy setup aligned with where the app runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用支持代理的 Flutter 客户端，例如 HttpClient、package:http 或 Dio，然后保持 iOS 或 Android 设备/模拟器的信任和代理设置与应用运行的位置一致。"
          }
        }
      }
    },
    "Use any application": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用任何应用程序"
          }
        }
      }
    },
    "Use console.log() to log events": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 console.log() 记录事件"
          }
        }
      }
    },
    "Use different message types for request and response": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为请求和响应使用不同的消息类型"
          }
        }
      }
    },
    "Use Empty Body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用空正文"
          }
        }
      }
    },
    "Use Extended Controls > Settings > Proxy, or start the emulator with -http-proxy, so the Android system picks up Rockxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“扩展控制”>“设置”>“代理”，或使用 -http-proxy 启动模拟器，以便 Android 系统识别 Rockxy。"
          }
        }
      }
    },
    "Use External Proxy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用外部代理"
          }
        }
      }
    },
    "Use Globally": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局使用"
          }
        }
      }
    },
    "Use letters, digits, or ! # $ % & ' * + - . ^ _ ` | ~ — no spaces or colons.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用字母、数字或 ! # $ % & ' * + - . ^ _ ` | ~，不能包含空格或冒号。"
          }
        }
      }
    },
    "Use Manual Setup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用手动设置"
          }
        }
      }
    },
    "Use Monospaced Font": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用等宽字体"
          }
        }
      }
    },
    "Use one of the Snippets tab variants for HttpClient, package:http, or Dio so the client explicitly routes debug traffic through Rockxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用“代码片段”标签页中适用于 HttpClient、package:http 或 Dio 的变体，让客户端明确通过 Rockxy 路由调试流量。"
          }
        }
      }
    },
    "Use Regex": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用正则表达式"
          }
        }
      }
    },
    "Use Rockxy's local proxy address and exported root certificate with your Ruby client.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你的 Ruby 客户端使用 Rockxy 的本地代理地址和导出的根证书。"
          }
        }
      }
    },
    "Use Rockxy's local proxy address and root certificate with your Python HTTP client.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Rockxy 的本地代理地址和根证书用于 Python HTTP 客户端。"
          }
        }
      }
    },
    "Use Rockxy's local proxy address with --proxy or HTTP_PROXY / HTTPS_PROXY and trust the exported root certificate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 --proxy 或 HTTP_PROXY / HTTPS_PROXY 使用 Rockxy 的本地代理地址，并信任导出的根证书。"
          }
        }
      }
    },
    "Use saved credentials for the upstream proxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对上游代理使用已保存的凭据。"
          }
        }
      }
    },
    "Use Share Certificate in Developer Setup or export the Rockxy PEM, install it in the simulator, then enable full trust under Settings > General > About > Certificate Trust Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在开发者设置中使用“共享证书”，或导出 Rockxy PEM 并安装到模拟器，然后在“设置”>“通用”>“关于本机”>“证书信任设置”中启用完全信任。"
          }
        }
      }
    },
    "Use the fetch probe after platform setup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成平台设置后使用 fetch 探测"
          }
        }
      }
    },
    "Use the horizontal inspector to review individual frames.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用水平检查器审查各个帧。"
          }
        }
      }
    },
    "Use the host that matches the runtime": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
