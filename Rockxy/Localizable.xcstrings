      }
    },
    "Set a manual HTTP proxy on the active Wi-Fi, install the Rockxy certificate profile in Safari, enable Full Trust, then cold-launch the React Native app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前 Wi-Fi 上设置手动 HTTP 代理，在 Safari 中安装 Rockxy 证书描述文件，启用完全信任，然后冷启动 React Native 应用。"
          }
        }
      }
    },
    "Set a manual HTTP proxy on the active Wi-Fi, scan the temporary Rockxy certificate link, install the profile, and enable full trust under Certificate Trust Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前 Wi-Fi 上设置手动 HTTP 代理，扫描临时 Rockxy 证书链接，安装描述文件，然后在“证书信任设置”中启用完全信任。"
          }
        }
      }
    },
    "Set a manual HTTP proxy on the device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上设置手动 HTTP 代理"
          }
        }
      }
    },
    "Set a manual proxy on the active Wi-Fi": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前 Wi-Fi 上设置手动代理"
          }
        }
      }
    },
    "Set a manual proxy on the active Wi-Fi, share or install the Rockxy PEM as a user CA, and rely on a debug build whose network-security-config trusts user CAs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前 Wi-Fi 上设置手动代理，将 Rockxy PEM 共享或安装为用户 CA，并使用其 network-security-config 信任用户 CA 的调试构建。"
          }
        }
      }
    },
    "Set the emulator proxy to 10.0.2.2 plus Rockxy's active port, install the Root CA in the emulator, and use the Android XML snippet for debug builds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将模拟器代理设置为 10.0.2.2 和 Rockxy 的当前端口，在模拟器中安装根 CA，并为调试构建使用 Android XML 代码片段。"
          }
        }
      }
    },
    "Set the macOS system proxy to Rockxy so simulator apps inherit it; simctl does not have a first-party proxy switch today.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 macOS 系统代理设置为 Rockxy，使模拟器 App 继承该设置；simctl 目前没有第一方代理开关。"
          }
        }
      }
    },
    "Set the Wi-Fi proxy to the Device Proxy host shown by Rockxy, install the Root CA as a user CA, and use a debug build whose network-security-config trusts user CAs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Wi-Fi 代理设为 Rockxy 显示的设备代理主机，将根 CA 安装为用户 CA，并使用其 network-security-config 信任用户 CA 的调试构建。"
          }
        }
      }
    },
