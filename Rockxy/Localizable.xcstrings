    "Manual trust command": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动信任命令"
          }
        }
      }
    },
    "Manual update checks are available in this local build. Automatic checks stay off while developing in Xcode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此本地构建可进行手动更新检查。在 Xcode 中开发时，自动检查保持关闭。"
          }
        }
      }
    },
    "Manual validation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动验证"
          }
        }
      }
    },
    "Manual validation only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅手动验证"
          }
        }
      }
    },
    "Manually configured clients that still reach Rockxy remain encrypted and are tunneled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍能连接 Rockxy 的手动配置客户端会保持加密，并通过隧道传输。"
          }
        }
      }
    },
    "Manually saved session files, rules, and favorites are not deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动保存的会话文件、规则和收藏项不会被删除。"
          }
        }
      }
    },
    "Map API Local": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map API Local"
          }
        }
      }
    },
    "Map Local": {
      "shouldTranslate": false
    },
    "Map Local Editor": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map Local 编辑器"
          }
        }
      }
    },
    "MAP LOCAL OFF": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MAP LOCAL 已关闭"
          }
        }
      }
    },
    "Map Local participates in Rockxy's global first-match rule order. Reorder rules from the More menu; unavailable local targets safely fall back to the origin.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map Local 遵循 Rockxy 的全局首个匹配规则顺序。可从“更多”菜单重新排序规则；不可用的本地目标会安全回退到源服务器。"
          }
        }
      }
    },
    "Map Local serves a matching request from a local file — you set the status code, headers, and body — so you can mock an endpoint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map Local 会为匹配的请求从本地文件提供响应，你可以设置状态码、标头和正文，从而模拟端点。"
          }
        }
      }
    },
    "Map Local...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map Local..."
          }
        }
      }
    },
    "Map Local…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Map Local…"
          }
