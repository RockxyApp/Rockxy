            "value": "正在于 %@ 启动"
          }
        }
      }
    },
    "macOS system traffic is not routed to Rockxy. The listener may still accept manually configured apps, but browser traffic will not be captured automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 系统流量未路由到 Rockxy。监听器仍可接收手动配置的应用流量，但浏览器流量不会自动被捕获。"
          }
        }
      }
