      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是"
          }
        }
      }
    },
    "You can cancel this check at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时取消此检查。"
          }
        }
      }
    },
    "You can still review the full release history.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍可查看完整的发布历史。"
          }
        }
      }
    },
    "You see the exact redacted snapshot before it is processed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理前，你会看到经过脱敏的确切快照。"
          }
        }
      }
    },
    "You: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你：%@"
          }
        }
      }
    },
    "You’re All Set!": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切准备就绪！"
          }
        }
      }
    },
    "Your current recording Request/Response data will be lost.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前记录的请求/响应数据将会丢失。"
          }
        }
      }
    },
    "Your current recording Request/Response data will be lost. Rockxy will stop capturing and restore macOS proxy settings before quitting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前记录的请求/响应数据将丢失。Rockxy 将停止捕获，并在退出前恢复 macOS 代理设置。"
          }
        }
      }
    },
    "Allow List Captures Nothing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表不会捕获任何流量"
          }
        }
      }
    },
    "Allow List is on, but no valid enabled rule can match. Traffic is still proxied, but it is not recorded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表已开启，但没有有效的已启用规则可以匹配。流量仍会被代理，但不会被记录。"
          }
        }
      }
    },
    "Capture Is Not Verified": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获尚未验证"
          }
        }
      }
    },
    "Capture Needs Attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获需要处理"
          }
        }
      }
    },
    "Capture path": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获链路"
          }
        }
      }
    },
    "Check failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查失败"
          }
        }
      }
    },
    "Checking Capture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查捕获"
          }
        }
      }
