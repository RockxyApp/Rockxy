    "Allow List controls what Rockxy records in the session. Non-matching traffic is still forwarded normally.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表控制 Rockxy 在会话中记录的内容。不匹配的流量仍会正常转发。"
          }
        }
      }
    },
    "Allow List hides the validation probe": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表会隐藏验证探测"
          }
        }
      }
    },
    "Allow List is active and does not allow the local validation probe URL, so Rockxy forwards it but does not record it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表已启用，但不允许本地验证探测 URL，因此 Rockxy 会转发该请求，但不会记录。"
          }
        }
      }
    },
    "Allow List is on, but no valid enabled rule can match. Rockxy will not record traffic until a rule is enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表已启用，但没有可匹配的有效已启用规则。在启用规则前，Rockxy 不会记录流量。"
          }
