<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Repeat, Edit and Repeat, and Compose re-send captured traffic exactly as the
		     client issued it, including plain http:// to LAN and staging servers. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Rockxy Project Configuration</string>
			<key>UTTypeIdentifier</key>
			<string>$(ROCKXY_SHARED_UTTYPE_PREFIX).project</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rockxyproject</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.rockxy.project+json</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Rockxy Session</string>
			<key>UTTypeIdentifier</key>
			<string>$(ROCKXY_SHARED_UTTYPE_PREFIX).session</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rockxysession</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright 2024–2026 Nguyen Huu Loc (Stephen) and Rockxy Contributors</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Rockxy receives sessions from a nearby Rockxy iPhone only after you approve a matching pairing code.</string>
	<key>RockxyBundledHelperVersion</key>
	<string>$(ROCKXY_HELPER_VERSION)</string>
	<key>RockxyBundledHelperBuild</key>
	<string>$(ROCKXY_HELPER_BUILD)</string>
	<key>RockxyDefaultsPrefix</key>
	<string>$(ROCKXY_DEFAULTS_PREFIX)</string>
	<key>RockxyFamilyNamespace</key>
	<string>$(ROCKXY_FAMILY_NAMESPACE)</string>
	<key>RockxyHelperBundleIdentifier</key>
	<string>$(ROCKXY_HELPER_BUNDLE_ID)</string>
	<key>RockxyHelperProtocolVersion</key>
	<string>$(ROCKXY_HELPER_PROTOCOL_VERSION)</string>
	<key>RockxyHelperMachServiceName</key>
	<string>$(ROCKXY_HELPER_MACH_SERVICE_NAME)</string>
	<key>RockxyHelperPlistName</key>
	<string>$(ROCKXY_HELPER_PLIST_NAME)</string>
	<key>RockxyAllowedCallerIdentifiers</key>
	<string>$(ROCKXY_ALLOWED_CALLER_IDENTIFIERS)</string>
	<key>RockxyLogSubsystem</key>
	<string>$(ROCKXY_LOG_SUBSYSTEM)</string>
	<key>RockxyNotificationPrefix</key>
	<string>$(ROCKXY_NOTIFICATION_PREFIX)</string>
	<key>RockxyAppSupportDirectoryName</key>
	<string>$(ROCKXY_APP_SUPPORT_DIRECTORY_NAME)</string>
	<key>RockxySharedSupportDirectoryName</key>
	<string>$(ROCKXY_SHARED_SUPPORT_DIRECTORY_NAME)</string>
	<key>RockxySharedCertificateLabelPrefix</key>
	<string>$(ROCKXY_SHARED_CERTIFICATE_LABEL_PREFIX)</string>
	<key>RockxySharedUTTypePrefix</key>
	<string>$(ROCKXY_SHARED_UTTYPE_PREFIX)</string>
	<key>RockxyBuildReleaseDate</key>
	<string>$(ROCKXY_BUILD_RELEASE_DATE)</string>
	<key>RockxyGitHubOAuthClientID</key>
	<string>$(ROCKXY_GITHUB_OAUTH_CLIENT_ID)</string>
	<key>RockxyUpdatesEnabled</key>
	<string>$(ROCKXY_UPDATES_ENABLED)</string>
	<key>SUFeedURL</key>
	<string>$(ROCKXY_SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(ROCKXY_SPARKLE_PUBLIC_ED_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>HTTP Archive</string>
			<key>UTTypeIdentifier</key>
			<string>$(ROCKXY_SHARED_UTTYPE_PREFIX).har</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>har</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Rockxy Session</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>$(ROCKXY_SHARED_UTTYPE_PREFIX).session</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>HTTP Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>$(ROCKXY_SHARED_UTTYPE_PREFIX).har</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
